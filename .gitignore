# The actual database files and logs should never be committed.
# Only commit SQL DDL/DML scripts (e.g., schema.sql, initial_data.sql).
data/
pg_log/
pg_tblspc/
postgresql.conf
pg_hba.conf

# Ignore common credentials/environment files
.env
.local_settings.py

